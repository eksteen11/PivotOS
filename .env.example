NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PIVOT_ENV=local

# 001 Meetings — configure server-side only after reviewing connection setup.
MEETINGS_APP_ORIGIN=
MEETINGS_JOB_SECRET=
# Base64 encoding of exactly 32 random bytes, separate from the job secret.
MEETINGS_TOKEN_KEY=
MEETINGS_GOOGLE_CLIENT_ID=
MEETINGS_GOOGLE_CLIENT_SECRET=
MEETINGS_GOOGLE_ACCOUNT=
# Optional Meta Cloud API adapter for meeting reminders only; eligibility/coexistence must be verified first.
MEETINGS_WHATSAPP_OWNER_ID=
MEETINGS_WHATSAPP_TOKEN=
MEETINGS_WHATSAPP_PHONE_ID=
MEETINGS_WHATSAPP_GRAPH_VERSION=
MEETINGS_WHATSAPP_PREPARATION_TEMPLATE=
MEETINGS_WHATSAPP_START_TEMPLATE=
MEETINGS_WHATSAPP_LANGUAGE=en
MEETINGS_WHATSAPP_APP_SECRET=
MEETINGS_WHATSAPP_VERIFY_TOKEN=

# Shared WhatsApp Business inbox channel for +27 82 772 1220.
# Presence of names does not mean connected. Sending stays disabled in code.
# Do not put live secrets in Git. Apply migration 0024 and set production secrets only after reviewed approval.
WHATSAPP_OWNER_ID=
WHATSAPP_DISPLAY_E164=+27827721220
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Dedicated intake number (NEW SIM/eSIM — not provided yet). Must differ from shared display/phone id.
WHATSAPP_INTAKE_DISPLAY_E164=
WHATSAPP_INTAKE_PHONE_NUMBER_ID=
WHATSAPP_INTAKE_WABA_ID=
# Comma-separated verified founder E.164 allowlist for intake captures (default +27827721220).
WHATSAPP_INTAKE_FOUNDER_ALLOWLIST=+27827721220
# Public callback once deployed: https://pivot-os.vercel.app/api/whatsapp/webhook
